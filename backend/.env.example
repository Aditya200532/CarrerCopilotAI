# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS for API + Socket.IO)
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/careerpilot

# Redis (cache + BullMQ queues)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# LLM (any OpenAI-compatible API: OpenAI, Groq, Together, Ollama via proxy...)
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Rate limiting (LLM-backed endpoints are stricter)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=20

# Cache TTLs (seconds)
CACHE_TTL_TOPIC=604800
CACHE_TTL_QUESTION=86400
